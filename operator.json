{
  "name": "FASTA",
  "description": "Imports a FASTA file of biological sequences.",
  "tags": [
    "import",
    "omics"
  ],
  "authors": [
    "tercen"
  ],
  "urls": [
    "https://github.com/tercen/read_fasta_operator"
  ],
  "properties": [],
  "operatorSpec": {
    "kind": "OperatorSpec",
    "ontologyUri": "https://tercen.com/_ontology/tercen",
    "ontologyVersion": "0.0.1",
    "inputSpecs": [
      {
        "kind": "CrosstabSpec",
        "metaFactors": [
          {
            "kind": "MetaFactor",
            "name": "Document ID",
            "type": "",
            "description": "Identifier for the document",
            "ontologyMapping": "document",
            "crosstabMapping": "column",
            "cardinality": "1..n",
            "factors": []
          }
        ],
        "axis": []
      }
    ],
    "outputSpecsV2": [
      {
        "kind": "OperatorJoinSpec",
        "joinOperators": [
          {
            "kind": "JoinOperator",
            "joinType": "left",
            "leftPair": {
              "kind": "ColumnPair",
              "lColumns": [],
              "rColumns": []
            },
            "rightRelation": {
              "kind": "TableRelation",
              "attributes": [
                {
                  "kind": "Attribute",
                  "name": "name",
                  "type": "string"
                },
                {
                  "kind": "Attribute",
                  "name": "letter",
                  "type": "string"
                },
                {
                  "kind": "Attribute",
                  "name": "position",
                  "type": "double"
                },
                {
                  "kind": "Attribute",
                  "name": "value",
                  "type": "double"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}